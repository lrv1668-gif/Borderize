<Project>

  <!-- Central Package Management: every NuGet version lives here; .csproj files
       reference packages without a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <!-- Test-only -->
  <ItemGroup>
    <PackageVersion Include="ExifLibNet" Version="2.1.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
