root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Language conventions already used throughout the codebase.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_sort_system_directives_first = false

# Naming: _camelCase for private instance fields.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Static readonly fields stay PascalCase (e.g. InputResolver.SupportedExtensions).
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

[Borderize.Tests/**.cs]
# Test names use Method_Scenario_Expectation underscores by convention.
dotnet_diagnostic.CA1707.severity = none
# xUnit collection-definition classes are named *Collection by convention.
dotnet_diagnostic.CA1711.severity = none
# Test classes implement IDisposable only for temp-dir cleanup; no finalizers.
dotnet_diagnostic.CA1816.severity = none
